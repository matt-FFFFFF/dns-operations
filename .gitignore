# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
tfplan
tfplan-*
*.tfplan

# Generated: the document the policy is evaluated against. Rebuilt by
# `make policy`; never reviewed, never committed.
/build/

# Zone exports pulled from Cloudflare while adopting a zone.
*.zone.txt

# Generated by `dnsctl import-blocks` when adopting a zone Cloudflare already
# serves. Pairs each record with its Cloudflare id, so it is a list of
# identifiers with a short life: regenerate it before an adoption, delete it
# after. Never committed -- see docs/adoption.md.
terraform/imports.tf

# Python and lint caches
__pycache__/
.ruff_cache/
